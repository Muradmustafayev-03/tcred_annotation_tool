# Optional locally. When omitted, the service creates a private token in its state directory.
TCRED_ADMIN_TOKEN=

# Optional local overrides. Railway injects PORT and RAILWAY_VOLUME_MOUNT_PATH automatically.
HOST=127.0.0.1
PORT=8770
TCRED_STATE_DIR=runtime

# Set this only when TCRED_STATE_DIR is an externally persistent filesystem.
TCRED_STORAGE_IS_DURABLE=false
